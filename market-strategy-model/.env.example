APP_ENV=development
APP_NAME=TRNDO Intelligence
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ENABLE_AI_BACKGROUND_ART=false
TAVILY_API_KEY=
YOUTUBE_API_KEY=
DATABASE_URL=sqlite:///./trndo_market.db
MAX_WEB_RESULTS=5
MAX_YOUTUBE_RESULTS=5
CACHE_TTL_SECONDS=21600
REQUEST_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
UPI_MERCHANT_VPA=
UPI_PAYEE_NAME=
PAYMENT_CURRENCY=INR
PUBLIC_BASE_URL=
PAYMENT_TOKEN_TTL_HOURS=24
PROMOTION_STORAGE_DIR=./storage/promotions
MAX_UPLOAD_MB=10
PROMOTION_DEMO_MODE=true
DEFAULT_MONTHLY_PROMOTION_LIMIT=5
TREND_FINDER_BASE_URL=http://127.0.0.1:5000
TREND_FINDER_TIMEOUT_SECONDS=60
AUTH_SESSION_TTL_HOURS=24
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
